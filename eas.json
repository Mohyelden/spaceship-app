{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HINT_MODE": "on_demand"
      }
    },
    "preview-auto": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HINT_MODE": "auto"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
